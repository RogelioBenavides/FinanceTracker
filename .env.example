# Database
DB_ROOT_PASSWORD=change_me_root
DB_NAME=finance_tracker
DB_USER=finance_user
DB_PASSWORD=change_me

# Auth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
JWT_SECRET=change_me_to_a_long_random_string

# CORS — comma-separated list of origins allowed to call the API
# Add every host/IP you'll access the app from
CORS_ORIGINS=http://YOUR_LOCAL_IP:8080,http://YOUR_TAILSCALE_IP:8080

# Where MariaDB data is stored on the host (TrueNAS dataset path)
DATA_DIR=/mnt/tank/apps/financetracker

# Port the app is exposed on
APP_PORT=8080
